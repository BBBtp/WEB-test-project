				{
					"name": "Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    // Сохраняем RSA токен",
									"    const token = pm.response.headers.get('X-Auth-Token');",
									"    if (token) {",
									"        pm.collectionVariables.set('rsa_token', token);",
									"        console.log('RSA токен сохранен в переменную rsa_token');",
									"    }",
									"    // Сохраняем CSRF токен из cookie ответа",
									"    const csrfCookie = pm.cookies.get('csrftoken');",
									"    if (csrfCookie) {",
									"        pm.collectionVariables.set('csrftoken', csrfCookie);",
									"        console.log('CSRF токен сохранен из cookie:', csrfCookie);",
									"    } else {",
									"        console.log('CSRF токен не найден в cookie. Выполните запрос Get CSRF Token перед логином.');",
									"    }",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-CSRFToken",
								"value": "{{csrftoken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/users/login/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users",
								"login",
								""
							]
						},
						"description": "Вход в систему. RSA токен автоматически сохраняется в переменную rsa_token из заголовка X-Auth-Token"
					},
					"response": []
				},
