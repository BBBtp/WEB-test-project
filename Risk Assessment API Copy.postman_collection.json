				{
					"name": "Get Public Key",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Сохраняем CSRF токен из cookie ответа",
									"const csrfCookie = pm.cookies.get('csrftoken');",
									"if (csrfCookie) {",
									"    pm.collectionVariables.set('csrftoken', csrfCookie);",
									"    console.log('CSRF токен получен и сохранен из cookie');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/users/public-key/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users",
								"public-key",
								""
							]
						},
						"description": "Получить публичный RSA ключ для шифрования. Также автоматически получает CSRF токен из cookie (если установлен)."
					},
					"response": []
				},
